---
import { Image } from "astro:assets";
import { bild } from "../bilder";
import { KATEGORIER } from "../consts";
import type { CollectionEntry } from "astro:content";
import { intern } from "../lankar";

interface Props {
  projekt: CollectionEntry<"projekt">;
  laddning?: "eager" | "lazy";
}
const { projekt, laddning = "lazy" } = Astro.props;
const d = projekt.data;
const omslag = bild(d.omslag);
const kategori = KATEGORIER[d.kategori];
// Som på liljewall.se: korten byter till projektets nästa bild när man pekar på dem.
const vaxla = d.uppslag.map((u) => u.bild).find((b) => b && b !== d.omslag);
---

<article class="kort" style={`--k: ${kategori.farg}`}>
  <a class="kort__lank" href={intern(`/projekt/${projekt.id}`)}>
    <span class="kort__bild">
      <Image
        src={omslag}
        alt={`${d.titel}, ${kategori.namn.toLowerCase()} i ${d.plats}`}
        widths={[420, 760, 1200]}
        sizes="(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 30vw"
        loading={laddning}
      />
      {
        vaxla && (
          <Image
            class="kort__vaxla"
            src={bild(vaxla)}
            alt=""
            widths={[420, 760, 1200]}
            sizes="(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 30vw"
            loading="lazy"
          />
        )
      }
    </span>
    <span class="kort__rad">
      <span class="tb kort__kategori">
        <span class="kort__ruta" aria-hidden="true"></span>
        {kategori.namn}
      </span>
      <span class="tb kort__ar">{d.ar}</span>
    </span>
    <h3 class="kort__titel">{d.titel}</h3>
    <p class="kort__plats">{d.plats} — {d.status}</p>
  </a>
</article>

<style>
  .kort {
    break-inside: avoid;
  }

  .kort__lank {
    display: block;
    text-decoration: none;
  }

  .kort__bild {
    display: block;
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--papper-djup);
  }

  .kort__bild :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kort__bild :global(.kort__vaxla) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 240ms ease;
  }

  .kort__lank:hover .kort__bild :global(.kort__vaxla),
  .kort__lank:focus-visible .kort__bild :global(.kort__vaxla) {
    opacity: 1;
  }

  .kort__kategori {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
  }

  .kort__ruta {
    width: 0.6rem;
    height: 0.6rem;
    background: var(--k);
  }

  .kort__rad {
    display: flex;
    justify-content: space-between;
    gap: var(--rum-3);
    padding-top: var(--rum-3);
    margin-top: var(--rum-3);
    border-top: 1px solid var(--linje);
  }

  .kort__titel {
    font-size: var(--t-l);
    margin-top: var(--rum-2);
  }

  .kort__lank:hover .kort__titel {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .kort__plats {
    font-size: var(--t-s);
    color: var(--krita);
    margin: 0.2em 0 0;
  }
</style>
