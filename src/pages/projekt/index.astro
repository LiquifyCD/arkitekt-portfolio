---
import { getCollection } from "astro:content";
import Bas from "../../layouts/Bas.astro";
import Projektkort from "../../komponenter/Projektkort.astro";
import { KATEGORIER } from "../../consts";

const projekt = (await getCollection("projekt")).sort((a, b) => a.data.ordning - b.data.ordning);

// En del per kategori, i menyns ordning. Tomma kategorier visas inte.
const delar = Object.entries(KATEGORIER)
  .map(([nyckel, k]) => ({
    nyckel,
    ...k,
    projekt: projekt.filter((p) => p.data.kategori === nyckel),
  }))
  .filter((d) => d.projekt.length > 0);
---

<Bas titel="Projekt" beskrivning="Bostäder, renoveringar, stadsbyggnad och publika byggnader.">
  <div class="sida topp">
    <h1>Projekt</h1>
    <ul class="register">
      {
        delar.map((d) => (
          <li>
            <a href={`#${d.nyckel}`} style={`--k: ${d.farg}`}>
              <span class="ruta" aria-hidden="true" />
              {d.namn}
              <span class="tb">{d.projekt.length}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  {
    delar.map((d, i) => (
      <section class="sida del" id={d.nyckel} style={`--k: ${d.farg}`} aria-labelledby={`rubrik-${d.nyckel}`}>
        <h2 class="del__rubrik" id={`rubrik-${d.nyckel}`}>
          <span class="ruta" aria-hidden="true" />
          {d.namn}
        </h2>
        <div class="rutnat">
          {d.projekt.map((p) => (
            <Projektkort projekt={p} laddning={i === 0 ? "eager" : "lazy"} />
          ))}
        </div>
      </section>
    ))
  }
</Bas>

<style>
  .topp {
    padding-top: var(--rum-7);
  }

  h1 {
    font-size: var(--t-2xl);
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .register {
    list-style: none;
    margin: var(--rum-5) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--rum-2) var(--rum-5);
  }

  .register a {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-family: var(--typ-display);
    font-size: var(--t-m);
    text-decoration: none;
  }

  .register a:hover {
    text-decoration: underline;
  }

  .ruta {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    flex-shrink: 0;
    background: var(--k);
  }

  .del {
    margin-top: var(--rum-7);
    /* Ankarhoppet ska landa under den klistrade raden, inte bakom den. */
    scroll-margin-top: calc(var(--topbar-h) + var(--rum-4));
  }

  .del__rubrik {
    display: flex;
    align-items: center;
    gap: 0.45em;
    font-size: var(--t-xl);
    padding-top: var(--rum-3);
    border-top: 3px solid var(--k);
    margin-bottom: var(--rum-5);
  }

  .rutnat {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--rum-6) var(--rum-5);
    align-items: start;
  }

  @media (max-width: 1000px) {
    .rutnat {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .rutnat {
      grid-template-columns: 1fr;
      gap: var(--rum-5);
    }
  }
</style>
