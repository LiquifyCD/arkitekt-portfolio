---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Bas from "../layouts/Bas.astro";
import Film from "../komponenter/Film.astro";
import Projektkort from "../komponenter/Projektkort.astro";
import Avsnittsrubrik from "../komponenter/Avsnittsrubrik.astro";
import { bild } from "../bilder";
import { ARKITEKT } from "../consts";

const projekt = (await getCollection("projekt")).sort((a, b) => a.data.ordning - b.data.ordning);
const urval = projekt.slice(0, 3);

const galleri = (await getCollection("galleri"))
  .sort((a, b) => a.data.ordning - b.data.ordning)
  .slice(0, 5);

const steg = [
  {
    nr: "01",
    rubrik: "Platsen först",
    text: "Mätning, solstudie och en dag på tomten innan en enda linje ritas. Det mesta är redan bestämt av marken.",
  },
  {
    nr: "02",
    rubrik: "Snitt före plan",
    text: "Huset förstås genom att kapas. Sektionen avgör dagsljus, höjder och hur trappan går — planen följer av den.",
  },
  {
    nr: "03",
    rubrik: "Modell i handen",
    text: "Varje skede får en fysisk modell. Det går inte att gömma ett dåligt förhållande mellan volymer i papp.",
  },
];
---

<Bas>
  <section class="hero" data-snitt="Manifest">
    <div class="sida">
      <p class="tb hero__ogonbryn">{ARKITEKT.titel} — {ARKITEKT.ort}</p>
      <h1 class="hero__namn">{ARKITEKT.namn}</h1>
      <p class="hero__ingress">{ARKITEKT.ingress}</p>
      <div class="hero__film">
        <Film />
      </div>
    </div>
  </section>

  <section class="avsnitt" data-snitt="Urval">
    <div class="sida">
      <Avsnittsrubrik
        etikett="Projekt"
        rubrik="Ett urval"
        lank="/projekt"
        lanktext="Alla projekt"
      />
      <div class="urval">
        {urval.map((p) => <Projektkort projekt={p} />)}
      </div>
    </div>
  </section>

  <section class="avsnitt" data-snitt="Galleri">
    <div class="sida">
      <Avsnittsrubrik
        etikett="Galleri"
        rubrik="Modeller"
        lank="/galleri"
        lanktext="Hela galleriet"
      />
    </div>
    <ul class="remsa">
      {
        galleri.map((post) => (
          <li class="remsa__post">
            <Image
              src={bild(post.data.bild)}
              alt={post.data.bildtext}
              widths={[320, 560, 900]}
              sizes="(max-width: 860px) 62vw, 22vw"
              loading="lazy"
            />
            <p class="tb remsa__text">{post.data.bildtext}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="avsnitt" data-snitt="Metodik">
    <div class="sida">
      <Avsnittsrubrik
        etikett="Metodik"
        rubrik="Tankeprocessen"
        lank="/metodik"
        lanktext="Läs mer"
      />
      <ol class="flode">
        {
          steg.map((s) => (
            <li class="flode__steg">
              <span class="tb flode__nr">{s.nr}</span>
              <h3 class="flode__rubrik">{s.rubrik}</h3>
              <p class="flode__text">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Bas>

<style>
  .hero {
    padding-top: var(--rum-7);
  }

  .hero__ogonbryn {
    margin: 0 0 var(--rum-4);
  }

  .hero__namn {
    font-size: clamp(2.4rem, 9.2vw, 8rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.92;
    margin-bottom: var(--rum-5);
  }

  .hero__ingress {
    font-size: var(--t-l);
    line-height: 1.45;
    max-width: 38ch;
    margin-bottom: var(--rum-7);
    font-variation-settings: "opsz" 28;
  }

  .hero__film {
    margin-bottom: var(--rum-6);
  }

  .avsnitt {
    padding-block: var(--rum-7) 0;
  }

  .urval {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--rum-6) var(--rum-5);
  }

  /* Remsan får spilla ut i marginalen och skrollas i sidled. */
  .remsa {
    list-style: none;
    margin: 0;
    padding: 0 var(--marg);
    display: flex;
    gap: var(--rum-4);
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .remsa__post {
    flex: 0 0 clamp(13rem, 22vw, 20rem);
  }

  .remsa__post :global(img) {
    width: 100%;
    height: auto;
    background: var(--papper-djup);
  }

  .remsa__text {
    margin: var(--rum-3) 0 0;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .flode {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1px;
    background: var(--linje);
    border-block: 1px solid var(--linje);
  }

  .flode__steg {
    background: var(--papper);
    padding: var(--rum-4) var(--rum-4) var(--rum-5);
    position: relative;
  }

  /* Pilen mellan stegen — skissens [ ] → [ ] → [ ]. */
  .flode__steg:not(:last-child)::after {
    content: "";
    position: absolute;
    top: var(--rum-5);
    right: -7px;
    width: 0;
    height: 0;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    border-left: 8px solid var(--grafit);
    z-index: 1;
  }

  .flode__nr {
    color: var(--blakopia);
  }

  .flode__rubrik {
    font-size: var(--t-l);
    margin: var(--rum-3) 0 var(--rum-3);
  }

  .flode__text {
    font-size: var(--t-s);
    color: color-mix(in srgb, var(--grafit) 80%, var(--papper));
  }

  @media (max-width: 700px) {
    .flode__steg:not(:last-child)::after {
      top: auto;
      right: auto;
      bottom: -7px;
      left: var(--rum-4);
      border-left: 5px solid transparent;
      border-right: 5px solid transparent;
      border-top: 8px solid var(--grafit);
      border-bottom: 0;
    }
  }
</style>
