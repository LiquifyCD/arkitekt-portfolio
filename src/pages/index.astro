---
import { getCollection, getEntry } from "astro:content";
import { Image } from "astro:assets";
import Bas from "../layouts/Bas.astro";
import Film from "../komponenter/Film.astro";
import Bok from "../komponenter/Bok.astro";
import Projektkort from "../komponenter/Projektkort.astro";
import { bild } from "../bilder";
import { ARKITEKT, KATEGORIER, STARTSIDA } from "../consts";
import { intern } from "../lankar";

const projekt = (await getCollection("projekt")).sort((a, b) => a.data.ordning - b.data.ordning);
const text = await getEntry("texter", STARTSIDA.bok);
const kik = await getEntry("projekt", STARTSIDA.extraKik);
if (!text || !kik) {
  throw new Error("STARTSIDA i src/consts.ts pekar på en text eller ett projekt som inte finns.");
}
const kikKategori = KATEGORIER[kik.data.kategori];
---

<Bas>
  <h1 class="dolj-visuellt">{ARKITEKT.namn}, {ARKITEKT.titel.toLowerCase()}</h1>
  <section class="sida sida--bred hero" aria-label="Film">
    <Film />
  </section>

  <section class="projekt" aria-labelledby="rubrik-projekt">
    <div class="sida rubrikrad">
      <h2 id="rubrik-projekt">Projekt!</h2>
      <div class="pilar" data-pilar hidden>
        <button type="button" class="pil" data-pil="-1" aria-label="Föregående">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="2"></path>
          </svg>
        </button>
        <button type="button" class="pil" data-pil="1" aria-label="Nästa">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2"></path>
          </svg>
        </button>
      </div>
    </div>

    <ul class="karusell" data-karusell>
      <li class="karusell__post" data-stor>
        <a class="ommig" href={intern("/om-mig")}>
          <span class="ommig__bild">
            <Image
              src={bild("portratt.jpg")}
              alt=""
              widths={[360, 640]}
              sizes="(max-width: 860px) 80vw, 28rem"
            />
          </span>
          <span class="ommig__text">
            <span class="ommig__rubrik">Om mig</span>
            <span class="tb">Vem som ritar, och varför</span>
          </span>
        </a>
      </li>
      {
        projekt.map((p) => (
          <li class="karusell__post">
            <Projektkort projekt={p} />
          </li>
        ))
      }
      <li class="karusell__post karusell__post--slut">
        <a class="alla" href={intern("/projekt")}>
          Alla projekt
          <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
            <path d="M5 12h13m0 0-5-5m5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6"
            ></path>
          </svg>
        </a>
      </li>
    </ul>
  </section>

  <section class="sida ordet" aria-labelledby="rubrik-ordet">
    <h2 class="ordet__rubrik" id="rubrik-ordet">{text.data.titel}</h2>
    <Bok uppslag={text.data.uppslag} titel={text.data.titel} papper kompakt />
    <div class="ordet__beskrivning">
      <p class="tb">{text.data.slag}</p>
      <p>{text.data.sammanfattning}</p>
      <a class="lank" href={intern(`/skrivet/${text.id}`)}>Läs hela texten</a>
    </div>
  </section>

  <section class="sida kik" aria-labelledby="rubrik-kik">
    <h2 class="kik__rubrik" id="rubrik-kik">Ta en extra kik!</h2>
    <a class="kik__kort" href={intern(`/projekt/${kik.id}`)} style={`--k: ${kikKategori.farg}`}>
      <span class="kik__bild">
        <Image
          src={bild(kik.data.omslag)}
          alt={kik.data.titel}
          widths={[560, 900, 1400]}
          sizes="(max-width: 860px) 92vw, 50vw"
        />
      </span>
      <span class="kik__text">
        <span class="tb kik__etikett">
          <span class="kik__ruta" aria-hidden="true"></span>
          {kik.data.roll} — {kik.data.ar}
        </span>
        <span class="kik__titel">{kik.data.titel}</span>
        <span class="kik__sammanfattning">{kik.data.sammanfattning}</span>
        <span class="lank">Se projektet</span>
      </span>
    </a>
  </section>
</Bas>

<style>
  /* Menyraden och filmen delar första skärmen. Filmen står kvar i 16:9 med
     luft runt om: bred på datorn, men aldrig högre än att den ryms. */
  .hero {
    --luft: clamp(1.5rem, 5svh, 4rem);
    --notis: 2.25rem;
    min-height: calc(100svh - var(--topbar-h));
    display: grid;
    align-content: center;
    padding-block: var(--luft);
  }

  .hero :global(.film) {
    width: min(100%, (100svh - var(--topbar-h) - 2 * var(--luft) - var(--notis)) * 16 / 9);
    margin-inline: auto;
  }

  .projekt {
    margin-top: var(--rum-7);
  }

  h2 {
    font-size: var(--t-xl);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  /* Projekt! — skissens remsa: Om mig först, sedan projekten, pil vidare. */
  .rubrikrad {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--rum-4);
    margin-bottom: var(--rum-5);
  }

  .pilar {
    display: flex;
    gap: var(--rum-2);
  }

  .pil {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--linje-stark);
    transition:
      background-color 140ms ease,
      color 140ms ease;
  }

  .pil:hover:not(:disabled) {
    background: var(--poche);
    color: var(--norrljus);
  }

  .pil:disabled {
    opacity: 0.28;
    cursor: default;
  }

  .karusell {
    --liten: clamp(14rem, 21vw, 19rem);
    --stor: clamp(18rem, 31vw, 28rem);
    list-style: none;
    margin: 0;
    /* Luft upptill så att fokusramen på det stora kortet inte klipps. */
    padding: var(--rum-2) var(--marg) var(--rum-3);
    display: flex;
    align-items: flex-end;
    gap: var(--rum-4);
    overflow-x: auto;
    /* proximity, inte mandatory: annars rycker remsan när ett kort växer. */
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--marg);
    scrollbar-width: none;
  }

  .karusell::-webkit-scrollbar {
    display: none;
  }

  /* Ett kort i taget är större: Om mig från början, sedan det kort man pekar
     på. Skriptet flyttar data-stor och håller radens höjd fast, så att ytan
     under inte hoppar medan korten byter storlek. */
  .karusell__post {
    flex: 0 0 var(--liten);
    scroll-snap-align: start;
    transition: flex-basis 240ms cubic-bezier(0.22, 0.7, 0.2, 1);
  }

  .karusell__post[data-stor] {
    flex-basis: var(--stor);
  }

  /* Skapas av skriptet och saknar därför Astros scope-attribut. */
  .karusell :global(.karusell__matt) {
    position: absolute;
    width: var(--stor);
    visibility: hidden;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .karusell__post {
      transition: none;
    }
  }

  .ommig {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: var(--poche);
    color: var(--norrljus);
  }

  .ommig__bild {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .ommig__bild :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 300ms ease;
  }

  .ommig:hover .ommig__bild :global(img) {
    filter: none;
  }

  .ommig__text {
    display: grid;
    gap: var(--rum-2);
    padding: var(--rum-4);
  }

  .ommig__rubrik {
    font-family: var(--typ-display);
    font-size: var(--t-xl);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .ommig .tb {
    color: color-mix(in srgb, var(--norrljus) 70%, transparent);
  }

  .karusell__post--slut {
    flex-basis: clamp(10rem, 16vw, 14rem);
  }

  .alla {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 3 / 4;
    padding: var(--rum-4);
    border: 1px solid var(--linje-stark);
    font-family: var(--typ-display);
    font-size: var(--t-l);
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .alla:hover {
    background: var(--papper-djup);
  }

  /* Ordets makt: boken, och beskrivningen under den. */
  .ordet {
    margin-top: var(--rum-8);
  }

  .ordet__rubrik {
    text-align: center;
    margin-bottom: var(--rum-5);
  }

  .ordet__beskrivning {
    max-width: 40rem;
    margin: var(--rum-6) auto 0;
    text-align: center;
  }

  .ordet__beskrivning p:not(.tb) {
    font-size: var(--t-l);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .ordet__beskrivning .tb {
    margin-bottom: var(--rum-3);
  }

  .lank {
    display: inline-block;
    margin-top: var(--rum-3);
    font-family: var(--typ-tb);
    font-size: var(--t-tb);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid var(--linje-stark);
    padding-bottom: 0.3em;
  }

  .lank:hover {
    border-color: currentColor;
  }

  /* Ta en extra kik! */
  .kik {
    margin-top: var(--rum-8);
  }

  .kik__rubrik {
    margin-bottom: var(--rum-5);
  }

  .kik__kort {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--rum-6);
    align-items: center;
    padding: var(--rum-4);
    border: 1px solid var(--linje-stark);
    text-decoration: none;
  }

  .kik__bild {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--papper-djup);
  }

  .kik__bild :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .kik__kort:hover .kik__bild :global(img) {
    transform: scale(1.02);
  }

  .kik__text {
    display: grid;
    gap: var(--rum-3);
    justify-items: start;
    padding-right: var(--rum-4);
  }

  .kik__etikett {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
  }

  .kik__ruta {
    width: 0.6rem;
    height: 0.6rem;
    background: var(--k);
  }

  .kik__titel {
    font-family: var(--typ-display);
    font-size: var(--t-xl);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: var(--rad-rubrik);
  }

  .kik__sammanfattning {
    font-size: var(--t-m);
  }

  @media (max-width: 860px) {
    /* Stående skärm: filmen i full bredd överst, ingen tvingad höjd. */
    .hero {
      min-height: 0;
      padding-block: var(--rum-4) 0;
    }

    .hero :global(.film) {
      width: 100%;
    }

    .karusell {
      --liten: 66vw;
      --stor: 80vw;
    }

    .karusell__post--slut {
      flex-basis: 44vw;
    }

    .kik__kort {
      grid-template-columns: 1fr;
      gap: var(--rum-4);
    }

    .kik__text {
      padding: 0 0 var(--rum-2);
    }
  }
</style>

<script>
  const karusell = document.querySelector<HTMLElement>("[data-karusell]");
  const pilar = document.querySelector<HTMLElement>("[data-pilar]");

  if (karusell && pilar) {
    const knappar = Array.from(pilar.querySelectorAll<HTMLButtonElement>("[data-pil]"));
    const steg = () => {
      const forsta = karusell.querySelector<HTMLElement>(".karusell__post");
      const glapp = parseFloat(getComputedStyle(karusell).columnGap) || 0;
      return (forsta?.offsetWidth ?? 300) + glapp;
    };

    const uppdatera = () => {
      const max = karusell.scrollWidth - karusell.clientWidth - 2;
      pilar.hidden = max <= 0;
      knappar[0].disabled = karusell.scrollLeft <= 2;
      knappar[1].disabled = karusell.scrollLeft >= max;
    };

    for (const knapp of knappar) {
      knapp.addEventListener("click", () => {
        const lugn = matchMedia("(prefers-reduced-motion: reduce)").matches;
        karusell.scrollBy({
          left: Number(knapp.dataset.pil) * steg(),
          behavior: lugn ? "auto" : "smooth",
        });
      });
    }

    karusell.addEventListener("scroll", uppdatera, { passive: true });
    addEventListener("resize", uppdatera);
    uppdatera();
  }

  if (karusell && matchMedia("(hover: hover)").matches) {
    const poster = Array.from(
      karusell.querySelectorAll<HTMLElement>(".karusell__post:not(.karusell__post--slut)"),
    );
    const standard = poster[0];

    const gorStor = (post: HTMLElement | null) => {
      if (!post || post.hasAttribute("data-stor")) return;
      for (const p of poster) p.toggleAttribute("data-stor", p === post);
    };

    // Radens höjd låses till den högsta den kan bli, oavsett vilket kort som
    // är stort. Bilderna är 4:3, så höjden är textdelen plus 3/4 av --stor.
    const matt = document.createElement("li");
    matt.className = "karusell__matt";
    matt.setAttribute("aria-hidden", "true");
    karusell.append(matt);

    const lasHojd = () => {
      const stor = matt.offsetWidth;
      const text = Math.max(...poster.map((p) => p.offsetHeight - p.offsetWidth * 0.75));
      const stil = getComputedStyle(karusell);
      const kant = parseFloat(stil.paddingTop) + parseFloat(stil.paddingBottom);
      karusell.style.minHeight = `${Math.ceil(text + stor * 0.75 + kant)}px`;
    };

    // Pekaren mellan två kort räknas inte som att lämna remsan; annars
    // växer Om mig tillbaka i varje glapp och korten fladdrar.
    karusell.addEventListener("pointerover", (e) => {
      if (e.pointerType === "touch") return;
      gorStor((e.target as Element).closest<HTMLElement>(".karusell__post:not(.karusell__post--slut)"));
    });
    karusell.addEventListener("pointerleave", () => {
      if (!karusell.contains(document.activeElement)) gorStor(standard);
    });
    karusell.addEventListener("focusin", (e) => {
      gorStor((e.target as Element).closest<HTMLElement>(".karusell__post:not(.karusell__post--slut)"));
    });
    karusell.addEventListener("focusout", (e) => {
      if (!karusell.contains(e.relatedTarget as Node | null)) gorStor(standard);
    });

    addEventListener("load", lasHojd);
    addEventListener("resize", lasHojd);
    lasHojd();
  }
</script>
