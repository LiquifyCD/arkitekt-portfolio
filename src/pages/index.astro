---
import { getCollection, getEntry } from "astro:content";
import { Image } from "astro:assets";
import Bas from "../layouts/Bas.astro";
import Film from "../komponenter/Film.astro";
import Bok from "../komponenter/Bok.astro";
import Projektkort from "../komponenter/Projektkort.astro";
import { bild } from "../bilder";
import { ARKITEKT, KATEGORIER, STARTSIDA } from "../consts";
import { intern } from "../lankar";

const projekt = (await getCollection("projekt")).sort((a, b) => a.data.ordning - b.data.ordning);
const text = await getEntry("texter", STARTSIDA.bok);
const kik = await getEntry("projekt", STARTSIDA.extraKik);
if (!text || !kik) {
  throw new Error("STARTSIDA i src/consts.ts pekar på en text eller ett projekt som inte finns.");
}
const kikKategori = KATEGORIER[kik.data.kategori];
---

<Bas>
  <h1 class="dolj-visuellt">{ARKITEKT.namn}, {ARKITEKT.titel.toLowerCase()}</h1>
  <section class="sida sida--bred hero" aria-label="Film">
    <Film />
  </section>

  <section class="sida sida--bred projekt" aria-labelledby="rubrik-projekt">
    <div class="projekt__rutnat">
      <h2 class="projekt__rubrik" id="rubrik-projekt">Projekt!</h2>
      <ul class="rad" role="list" data-rad>
        <li class="rad__post rad__post--ommig" data-stor>
          <a class="ommig" href={intern("/om-mig")}>
            <span class="ommig__bild">
              <Image
                src={bild("portratt.jpg")}
                alt=""
                widths={[360, 640]}
                sizes="(max-width: 700px) 46vw, (max-width: 1100px) 48vw, 22vw"
              />
            </span>
            <span class="ommig__text">
              <span class="ommig__rubrik">Om mig</span>
              <span class="tb">Vem som ritar, och varför</span>
            </span>
          </a>
        </li>
        {
          projekt.map((p) => (
            <li class="rad__post">
              <Projektkort projekt={p} />
            </li>
          ))
        }
        <li class="rad__post rad__post--alla">
          <a class="alla" href={intern("/projekt")}>
            Alla projekt
            <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
              <path d="M5 12h13m0 0-5-5m5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6"
              ></path>
            </svg>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="sida ordet" aria-labelledby="rubrik-ordet">
    <h2 class="ordet__rubrik" id="rubrik-ordet">{text.data.titel}</h2>
    <Bok uppslag={text.data.uppslag} titel={text.data.titel} papper kompakt />
    <div class="ordet__beskrivning">
      <p class="tb">{text.data.slag}</p>
      <p>{text.data.sammanfattning}</p>
      <a class="lank" href={intern(`/skrivet/${text.id}`)}>Läs hela texten</a>
    </div>
  </section>

  <section class="sida kik" aria-labelledby="rubrik-kik">
    <h2 class="kik__rubrik" id="rubrik-kik">Ta en extra kik!</h2>
    <a class="kik__kort" href={intern(`/projekt/${kik.id}`)} style={`--k: ${kikKategori.farg}`}>
      <span class="kik__bild">
        <Image
          src={bild(kik.data.omslag)}
          alt={kik.data.titel}
          widths={[560, 900, 1400]}
          sizes="(max-width: 860px) 92vw, 50vw"
        />
      </span>
      <span class="kik__text">
        <span class="tb kik__etikett">
          <span class="kik__ruta" aria-hidden="true"></span>
          {kik.data.roll} — {kik.data.ar}
        </span>
        <span class="kik__titel">{kik.data.titel}</span>
        <span class="kik__sammanfattning">{kik.data.sammanfattning}</span>
        <span class="lank">Se projektet</span>
      </span>
    </a>
  </section>
</Bas>

<style>
  /* Menyraden och filmen delar första skärmen. Filmen står kvar i 16:9 med
     luft runt om: bred på datorn, men aldrig högre än att den ryms. */
  .hero {
    --luft: clamp(1.5rem, 5svh, 4rem);
    --notis: 2.25rem;
    min-height: calc(100svh - var(--topbar-h));
    display: grid;
    align-content: center;
    padding-block: var(--luft);
  }

  /* Bildtexten under filmen räknas inte med när filmen centreras. */
  .hero :global(.film__notis) {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
  }

  .hero :global(.film) {
    width: min(100%, (100svh - var(--topbar-h) - 2 * var(--luft) - var(--notis)) * 16 / 9);
    margin-inline: auto;
  }

  h2 {
    font-size: var(--t-xl);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  /* Projekt! har en egen skärmhöjd. Allt ryms i en rad utan rullning:
     Om mig är högst och står först, rubriken ligger i luften ovanför de
     första projekten, och korten står på samma baslinje. */
  .projekt {
    min-height: calc(100svh - var(--topbar-h));
    display: grid;
    align-content: center;
    padding-block: var(--rum-6);
  }

  .projekt__rutnat {
    --kolumner: minmax(0, 1.5fr) repeat(6, minmax(0, 1fr));
    --ommig-rader: 1 / span 2;
    display: grid;
    grid-template-columns: var(--kolumner);
    /* 1fr: raden fylls av det Om mig sticker upp över korten, så att
       rubriken hamnar precis ovanför dem. */
    grid-template-rows: 1fr auto;
    column-gap: var(--rum-3);
    row-gap: var(--rum-5);
  }

  .rad {
    display: contents;
    list-style: none;
  }

  .projekt__rubrik {
    grid-column: var(--rubrik-kol, 2 / -1);
    grid-row: 1;
    align-self: end;
    line-height: 1.12;
  }

  .rad__post--ommig {
    grid-column: var(--ommig-kol, 1);
    grid-row: var(--ommig-rader);
    align-self: end;
  }

  .rad__post {
    transform-origin: 50% 100%;
    transition: transform 200ms cubic-bezier(0.22, 0.7, 0.2, 1);
  }

  .rad__post--ommig {
    transform-origin: 0 100%;
  }

  /* Pekar man på ett projekt växer det och Om mig krymper. Bara transform,
     så att inget annat på sidan flyttar sig. */
  .rad__post[data-stor]:not(.rad__post--ommig) {
    transform: scale(1.08);
    z-index: 1;
  }

  .rad:has(.rad__post[data-stor]:not(.rad__post--ommig)) .rad__post--ommig {
    transform: scale(0.94);
  }

  /* Porträttformat i raden: smala kort får mer bild. */
  .projekt :global(.kort__bild) {
    aspect-ratio: 4 / 5;
  }

  .ommig {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: var(--poche);
    color: var(--norrljus);
  }

  .ommig__bild {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .ommig__bild :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 300ms ease;
  }

  .ommig:hover .ommig__bild :global(img) {
    filter: none;
  }

  .ommig__text {
    display: grid;
    gap: var(--rum-2);
    padding: var(--rum-4);
  }

  .ommig__rubrik {
    font-family: var(--typ-display);
    font-size: var(--t-xl);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .ommig .tb {
    color: color-mix(in srgb, var(--norrljus) 70%, transparent);
  }

  /* Alla projekt: lika hög som projektkorten, eftersom den sträcks över
     samma rad som de. */
  .rad__post--alla {
    display: flex;
  }

  .alla {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--rum-4);
    border: 1px solid var(--linje-stark);
    font-family: var(--typ-display);
    font-size: var(--t-l);
    line-height: 1.15;
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .alla:hover {
    background: var(--papper-djup);
  }

  /* Platta: Om mig två kolumner bred bredvid rubriken och två projekt,
     resten i en full rad under — rutnätet går jämnt ut. */
  @media (max-width: 1100px) {
    .projekt__rutnat {
      --kolumner: repeat(4, minmax(0, 1fr));
      --ommig-kol: 1 / span 2;
      --rubrik-kol: 3 / -1;
    }
  }

  /* Telefon: två kolumner. Om mig sträcks bredvid rubriken och första
     projektet; alla rader under är lika höga, så Alla projekt blir lika
     hög som korten även när den står ensam sist. */
  @media (max-width: 700px) {
    .projekt__rutnat {
      --kolumner: repeat(2, minmax(0, 1fr));
      --ommig-kol: 1;
      --rubrik-kol: 2;
      grid-template-rows: auto;
      grid-auto-rows: 1fr;
    }

    .rad__post--ommig {
      align-self: stretch;
      display: flex;
    }

    .ommig {
      flex: 1;
    }

    .ommig__bild {
      position: relative;
      flex: 1;
      aspect-ratio: auto;
      min-height: 8rem;
    }

    .ommig__bild :global(img) {
      position: absolute;
      inset: 0;
    }

    .ommig__text,
    .alla {
      padding: var(--rum-3);
    }
  }

  /* Ordets makt: boken, och beskrivningen under den. */
  .ordet {
    margin-top: var(--rum-8);
  }

  .ordet__rubrik {
    text-align: center;
    margin-bottom: var(--rum-5);
  }

  .ordet__beskrivning {
    max-width: 40rem;
    margin: var(--rum-6) auto 0;
    text-align: center;
  }

  .ordet__beskrivning p:not(.tb) {
    font-size: var(--t-l);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .ordet__beskrivning .tb {
    margin-bottom: var(--rum-3);
  }

  .lank {
    display: inline-block;
    margin-top: var(--rum-3);
    font-family: var(--typ-tb);
    font-size: var(--t-tb);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid var(--linje-stark);
    padding-bottom: 0.3em;
  }

  .lank:hover {
    border-color: currentColor;
  }

  /* Ta en extra kik! */
  .kik {
    margin-top: var(--rum-8);
  }

  .kik__rubrik {
    margin-bottom: var(--rum-5);
  }

  .kik__kort {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--rum-6);
    align-items: center;
    padding: var(--rum-4);
    border: 1px solid var(--linje-stark);
    text-decoration: none;
  }

  .kik__bild {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--papper-djup);
  }

  .kik__bild :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .kik__kort:hover .kik__bild :global(img) {
    transform: scale(1.02);
  }

  .kik__text {
    display: grid;
    gap: var(--rum-3);
    justify-items: start;
    padding-right: var(--rum-4);
  }

  .kik__etikett {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
  }

  .kik__ruta {
    width: 0.6rem;
    height: 0.6rem;
    background: var(--k);
  }

  .kik__titel {
    font-family: var(--typ-display);
    font-size: var(--t-xl);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: var(--rad-rubrik);
  }

  .kik__sammanfattning {
    font-size: var(--t-m);
  }

  @media (max-width: 860px) {
    /* Stående skärm: filmen i full bredd, mitt i sin egen skärmhöjd. */
    .hero :global(.film) {
      width: 100%;
    }

    .kik__kort {
      grid-template-columns: 1fr;
      gap: var(--rum-4);
    }

    .kik__text {
      padding: 0 0 var(--rum-2);
    }
  }
</style>

<script>
  // Ett kort i taget är förstorat. Skriptet flyttar data-stor i stället för
  // ren :hover, så att glappen mellan korten inte räknas som att pekaren
  // lämnat raden — annars fladdrar Om mig tillbaka i varje mellanrum.
  const rutnat = document.querySelector<HTMLElement>(".projekt__rutnat");

  if (rutnat && matchMedia("(hover: hover)").matches) {
    const valbara = ".rad__post:not(.rad__post--alla)";
    const poster = Array.from(rutnat.querySelectorAll<HTMLElement>(valbara));
    const standard = poster[0];

    const gorStor = (post: HTMLElement | null) => {
      if (!post || post.hasAttribute("data-stor")) return;
      for (const p of poster) p.toggleAttribute("data-stor", p === post);
    };
    const narmast = (e: Event) => (e.target as Element).closest<HTMLElement>(valbara);

    rutnat.addEventListener("pointerover", (e) => {
      if (e.pointerType !== "touch") gorStor(narmast(e));
    });
    rutnat.addEventListener("pointerleave", () => {
      if (!rutnat.contains(document.activeElement)) gorStor(standard);
    });
    rutnat.addEventListener("focusin", (e) => gorStor(narmast(e)));
    rutnat.addEventListener("focusout", (e) => {
      if (!rutnat.contains(e.relatedTarget as Node | null)) gorStor(standard);
    });
  }
</script>
