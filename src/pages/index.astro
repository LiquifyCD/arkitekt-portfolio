---
import { getCollection, getEntry } from "astro:content";
import { Image } from "astro:assets";
import Bas from "../layouts/Bas.astro";
import Film from "../komponenter/Film.astro";
import Bok from "../komponenter/Bok.astro";
import Projektkort from "../komponenter/Projektkort.astro";
import { bild } from "../bilder";
import { KATEGORIER, MANIFEST, STARTSIDA } from "../consts";
import { intern } from "../lankar";

const projekt = (await getCollection("projekt")).sort((a, b) => a.data.ordning - b.data.ordning);
const text = await getEntry("texter", STARTSIDA.bok);
const kik = await getEntry("projekt", STARTSIDA.extraKik);
if (!text || !kik) {
  throw new Error("STARTSIDA i src/consts.ts pekar på en text eller ett projekt som inte finns.");
}
const kikKategori = KATEGORIER[kik.data.kategori];
---

<Bas>
  <section class="sida hero" aria-label="Film">
    <Film />
  </section>

  <section class="sida manifest" aria-label="Manifest">
    <p class="manifest__text">{MANIFEST}</p>
  </section>

  <section class="projekt" aria-labelledby="rubrik-projekt">
    <div class="sida rubrikrad">
      <h2 id="rubrik-projekt">Projekt!</h2>
      <div class="pilar" data-pilar hidden>
        <button type="button" class="pil" data-pil="-1" aria-label="Föregående">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="2"></path>
          </svg>
        </button>
        <button type="button" class="pil" data-pil="1" aria-label="Nästa">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2"></path>
          </svg>
        </button>
      </div>
    </div>

    <ul class="karusell" data-karusell>
      <li class="karusell__post">
        <a class="ommig" href={intern("/om-mig")}>
          <span class="ommig__bild">
            <Image
              src={bild("portratt.jpg")}
              alt=""
              widths={[360, 640]}
              sizes="(max-width: 700px) 78vw, 22rem"
            />
          </span>
          <span class="ommig__text">
            <span class="ommig__rubrik">Om mig</span>
            <span class="tb">Vem som ritar, och varför</span>
          </span>
        </a>
      </li>
      {
        projekt.map((p) => (
          <li class="karusell__post">
            <Projektkort projekt={p} />
          </li>
        ))
      }
      <li class="karusell__post karusell__post--slut">
        <a class="alla" href={intern("/projekt")}>
          Alla projekt
          <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
            <path d="M5 12h13m0 0-5-5m5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6"
            ></path>
          </svg>
        </a>
      </li>
    </ul>
  </section>

  <section class="sida ordet" aria-labelledby="rubrik-ordet">
    <h2 class="ordet__rubrik" id="rubrik-ordet">{text.data.titel}</h2>
    <Bok uppslag={text.data.uppslag} titel={text.data.titel} papper kompakt />
    <div class="ordet__beskrivning">
      <p class="tb">{text.data.slag}</p>
      <p>{text.data.sammanfattning}</p>
      <a class="lank" href={intern(`/skrivet/${text.id}`)}>Läs hela texten</a>
    </div>
  </section>

  <section class="sida kik" aria-labelledby="rubrik-kik">
    <h2 class="kik__rubrik" id="rubrik-kik">Ta en extra kik!</h2>
    <a class="kik__kort" href={intern(`/projekt/${kik.id}`)} style={`--k: ${kikKategori.farg}`}>
      <span class="kik__bild">
        <Image
          src={bild(kik.data.omslag)}
          alt={kik.data.titel}
          widths={[560, 900, 1400]}
          sizes="(max-width: 860px) 92vw, 50vw"
        />
      </span>
      <span class="kik__text">
        <span class="tb kik__etikett">
          <span class="kik__ruta" aria-hidden="true"></span>
          {kik.data.roll} — {kik.data.ar}
        </span>
        <span class="kik__titel">{kik.data.titel}</span>
        <span class="kik__sammanfattning">{kik.data.sammanfattning}</span>
        <span class="lank">Se projektet</span>
      </span>
    </a>
  </section>
</Bas>

<style>
  .hero {
    padding-top: var(--rum-5);
  }

  .manifest {
    padding-block: var(--rum-7);
  }

  .manifest__text {
    font-family: var(--typ-display);
    font-size: var(--t-xl);
    font-weight: 500;
    letter-spacing: -0.028em;
    line-height: 1.12;
    max-width: 26ch;
    text-wrap: balance;
  }

  h2 {
    font-size: var(--t-xl);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  /* Projekt! — skissens remsa: Om mig först, sedan projekten, pil vidare. */
  .rubrikrad {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--rum-4);
    margin-bottom: var(--rum-5);
  }

  .pilar {
    display: flex;
    gap: var(--rum-2);
  }

  .pil {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--linje-stark);
    transition:
      background-color 140ms ease,
      color 140ms ease;
  }

  .pil:hover:not(:disabled) {
    background: var(--poche);
    color: var(--norrljus);
  }

  .pil:disabled {
    opacity: 0.28;
    cursor: default;
  }

  .karusell {
    list-style: none;
    margin: 0;
    padding: 0 var(--marg) var(--rum-3);
    display: flex;
    gap: var(--rum-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--marg);
    scrollbar-width: none;
  }

  .karusell::-webkit-scrollbar {
    display: none;
  }

  .karusell__post {
    flex: 0 0 clamp(15rem, 26vw, 22rem);
    scroll-snap-align: start;
  }

  .ommig {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    background: var(--poche);
    color: var(--norrljus);
  }

  .ommig__bild {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .ommig__bild :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 300ms ease;
  }

  .ommig:hover .ommig__bild :global(img) {
    filter: none;
  }

  .ommig__text {
    display: grid;
    gap: var(--rum-2);
    padding: var(--rum-4);
  }

  .ommig__rubrik {
    font-family: var(--typ-display);
    font-size: var(--t-xl);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .ommig .tb {
    color: color-mix(in srgb, var(--norrljus) 70%, transparent);
  }

  .karusell__post--slut {
    flex-basis: clamp(10rem, 16vw, 14rem);
  }

  .alla {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 3 / 4;
    padding: var(--rum-4);
    border: 1px solid var(--linje-stark);
    font-family: var(--typ-display);
    font-size: var(--t-l);
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .alla:hover {
    background: var(--papper-djup);
  }

  /* Ordets makt: boken, och beskrivningen under den. */
  .ordet {
    margin-top: var(--rum-8);
  }

  .ordet__rubrik {
    text-align: center;
    margin-bottom: var(--rum-5);
  }

  .ordet__beskrivning {
    max-width: var(--matt-text);
    margin: var(--rum-6) auto 0;
    text-align: center;
  }

  .ordet__beskrivning .tb {
    margin-bottom: var(--rum-3);
  }

  .lank {
    display: inline-block;
    margin-top: var(--rum-3);
    font-family: var(--typ-tb);
    font-size: var(--t-tb);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid var(--linje-stark);
    padding-bottom: 0.3em;
  }

  .lank:hover {
    border-color: currentColor;
  }

  /* Ta en extra kik! */
  .kik {
    margin-top: var(--rum-8);
  }

  .kik__rubrik {
    margin-bottom: var(--rum-5);
  }

  .kik__kort {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--rum-6);
    align-items: center;
    padding: var(--rum-4);
    border: 1px solid var(--linje-stark);
    text-decoration: none;
  }

  .kik__bild {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--papper-djup);
  }

  .kik__bild :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .kik__kort:hover .kik__bild :global(img) {
    transform: scale(1.02);
  }

  .kik__text {
    display: grid;
    gap: var(--rum-3);
    justify-items: start;
    padding-right: var(--rum-4);
  }

  .kik__etikett {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
  }

  .kik__ruta {
    width: 0.6rem;
    height: 0.6rem;
    background: var(--k);
  }

  .kik__titel {
    font-family: var(--typ-display);
    font-size: var(--t-xl);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: var(--rad-rubrik);
  }

  .kik__sammanfattning {
    font-size: var(--t-m);
  }

  @media (max-width: 860px) {
    .hero {
      padding-top: var(--rum-4);
      padding-inline: 0;
    }

    .hero :global(.film__notis) {
      padding-inline: var(--marg);
    }

    .manifest {
      padding-block: var(--rum-6);
    }

    .karusell__post {
      flex-basis: 78vw;
    }

    .karusell__post--slut {
      flex-basis: 44vw;
    }

    .kik__kort {
      grid-template-columns: 1fr;
      gap: var(--rum-4);
    }

    .kik__text {
      padding: 0 0 var(--rum-2);
    }
  }
</style>

<script>
  const karusell = document.querySelector<HTMLElement>("[data-karusell]");
  const pilar = document.querySelector<HTMLElement>("[data-pilar]");

  if (karusell && pilar) {
    const knappar = Array.from(pilar.querySelectorAll<HTMLButtonElement>("[data-pil]"));
    const steg = () => {
      const forsta = karusell.querySelector<HTMLElement>(".karusell__post");
      const glapp = parseFloat(getComputedStyle(karusell).columnGap) || 0;
      return (forsta?.offsetWidth ?? 300) + glapp;
    };

    const uppdatera = () => {
      const max = karusell.scrollWidth - karusell.clientWidth - 2;
      pilar.hidden = max <= 0;
      knappar[0].disabled = karusell.scrollLeft <= 2;
      knappar[1].disabled = karusell.scrollLeft >= max;
    };

    for (const knapp of knappar) {
      knapp.addEventListener("click", () => {
        const lugn = matchMedia("(prefers-reduced-motion: reduce)").matches;
        karusell.scrollBy({
          left: Number(knapp.dataset.pil) * steg(),
          behavior: lugn ? "auto" : "smooth",
        });
      });
    }

    karusell.addEventListener("scroll", uppdatera, { passive: true });
    addEventListener("resize", uppdatera);
    uppdatera();
  }
</script>
