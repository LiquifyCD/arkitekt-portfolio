---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Bas from "../layouts/Bas.astro";
import { bild } from "../bilder";

const poster = (await getCollection("galleri")).sort((a, b) => a.data.ordning - b.data.ordning);
---

<Bas
  titel="Fotogalleri"
  beskrivning="Arbetsmodeller i papp, gips och trä, från skiss till färdig handling."
>
  <div class="galleri">
    <header class="topp">
      <div>
        <p class="tb">Fotogalleri</p>
        <h1>Modeller</h1>
      </div>
      <p class="topp__ingress text-matt">
        Varje skede får en modell. De är arbetsredskap, inte presentationer — därför
        är de gjorda i papp och kapspill och därför ser de ut som de gör.
      </p>
    </header>

    <ul class="rutnat">
      {
        poster.map((post, i) => (
          <li class="post">
            <button
              type="button"
              class="post__knapp"
              aria-haspopup="dialog"
              data-lyft
              data-bildtext={post.data.bildtext}
              data-fakta={[post.data.material, post.data.skala, post.data.ar]
                .filter(Boolean)
                .join(" — ")}
            >
              <Image
                src={bild(post.data.bild)}
                alt={post.data.bildtext}
                widths={[380, 700, 1200]}
                sizes="(max-width: 700px) 48vw, (max-width: 1100px) 33vw, 25vw"
                loading={i < 8 ? "eager" : "lazy"}
              />
              <span class="post__text" aria-hidden="true">
                <span class="tb post__bildtext">{post.data.bildtext}</span>
                <span class="tb post__fakta">
                  {[post.data.material, post.data.skala].filter(Boolean).join(" — ")}
                </span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <dialog class="lyft" data-lyftruta aria-label="Förstorad bild">
    <form method="dialog" class="lyft__stang">
      <button type="submit" aria-label="Stäng">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2"></path>
        </svg>
      </button>
    </form>
    <img data-lyft-bild alt="" />
    <p class="tb lyft__text" data-lyft-text></p>
  </dialog>
</Bas>

<style>
  /* Menyraden och galleriet fyller tillsammans första skärmen; sidfoten
     kommer först därefter. Galleriet går nästan kant i kant. */
  .galleri {
    --kant: clamp(0.75rem, 0.35rem + 1.3vw, 1.75rem);
    min-height: calc(100svh - var(--topbar-h));
    display: flex;
    flex-direction: column;
    gap: var(--rum-5);
    padding: var(--rum-5) var(--kant);
  }

  /* Sidfoten följer direkt efter första skärmen, utan sin vanliga luft. */
  :global(main:has(.galleri) + .sidfot) {
    margin-top: 0;
  }

  .topp {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--rum-3) var(--rum-6);
  }

  h1 {
    font-size: var(--t-2xl);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin: var(--rum-2) 0 0;
  }

  .topp__ingress {
    margin: 0;
    font-size: var(--t-l);
    line-height: 1.45;
    font-variation-settings: "opsz" 24;
  }

  /* Jämnt rutnät som skissens galleriruta. Raderna sträcks så att rutnätet
     fyller resten av skärmen; bilderna beskärs till rutan och syns hela i
     lyftrutan. */
  .rutnat {
    flex: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(11rem, auto);
    align-content: stretch;
    gap: var(--rum-5);
  }

  .post {
    display: flex;
  }

  .post__knapp {
    position: relative;
    display: block;
    flex: 1;
    padding: 0;
    overflow: hidden;
    text-align: left;
    background: var(--papper-djup);
  }

  .post__knapp :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms cubic-bezier(0.22, 0.7, 0.2, 1);
  }

  .post__knapp:hover :global(img),
  .post__knapp:focus-visible :global(img) {
    transform: scale(1.04);
  }

  .post__knapp:focus-visible {
    outline-offset: -3px;
  }

  .post__text {
    position: absolute;
    inset: auto 0 0;
    padding: var(--rum-5) var(--rum-3) var(--rum-3);
    background: linear-gradient(to top, color-mix(in srgb, var(--poche) 82%, transparent), transparent);
    color: var(--norrljus);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 200ms ease,
      transform 260ms cubic-bezier(0.22, 0.7, 0.2, 1);
  }

  .post__knapp:hover .post__text,
  .post__knapp:focus-visible .post__text {
    opacity: 1;
    transform: none;
  }

  .post__bildtext {
    display: block;
    text-transform: none;
    letter-spacing: 0.02em;
    line-height: 1.35;
    color: inherit;
  }

  .post__fakta {
    display: block;
    margin-top: 0.3em;
    color: color-mix(in srgb, var(--norrljus) 78%, transparent);
  }

  /* Pekskärmar har ingen hovring: där visas bildtexten inte alls i rutan,
     den finns i lyftrutan. */
  @media (hover: none) {
    .post__text {
      display: none;
    }
  }

  .lyft {
    border: 0;
    padding: 0;
    max-width: min(92vw, 78rem);
    max-height: 92vh;
    background: var(--papper);
    color: var(--grafit);
  }

  .lyft::backdrop {
    background: color-mix(in srgb, var(--poche) 86%, transparent);
  }

  .lyft img {
    display: block;
    max-width: 100%;
    max-height: 80vh;
    width: auto;
    margin-inline: auto;
  }

  .lyft__text {
    margin: 0;
    padding: var(--rum-3) var(--rum-4);
    text-transform: none;
    letter-spacing: 0.02em;
    border-top: 1px solid var(--linje);
  }

  .lyft__stang {
    position: absolute;
    top: 0;
    right: 0;
  }

  .lyft__stang button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--poche);
    color: var(--norrljus);
  }

  @media (max-width: 1100px) {
    .rutnat {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .rutnat {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: minmax(6.5rem, auto);
      gap: var(--rum-3);
    }

    .topp__ingress {
      font-size: var(--t-m);
    }
  }
</style>

<script>
  const ruta = document.querySelector<HTMLDialogElement>("[data-lyftruta]");
  const lyftBild = document.querySelector<HTMLImageElement>("[data-lyft-bild]");
  const lyftText = document.querySelector<HTMLElement>("[data-lyft-text]");

  if (ruta && lyftBild && lyftText) {
    document.querySelectorAll<HTMLButtonElement>("[data-lyft]").forEach((knapp) => {
      knapp.addEventListener("click", () => {
        const kalla = knapp.querySelector("img");
        if (!kalla) return;
        lyftBild.src = kalla.currentSrc || kalla.src;
        lyftBild.alt = knapp.dataset.bildtext ?? "";
        lyftText.textContent = [knapp.dataset.bildtext, knapp.dataset.fakta]
          .filter(Boolean)
          .join(" — ");
        ruta.showModal();
      });
    });

    // Klick utanför bilden stänger.
    ruta.addEventListener("click", (e) => {
      if (e.target === ruta) ruta.close();
    });
  }
</script>
