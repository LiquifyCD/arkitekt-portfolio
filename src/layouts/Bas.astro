---
import "@fontsource-variable/familjen-grotesk";
import "@fontsource-variable/newsreader";
import "@fontsource-variable/spline-sans-mono";
import "../stilar/tokens.css";
import "../stilar/bas.css";

import Topbar from "../komponenter/Topbar.astro";
import Sidfot from "../komponenter/Sidfot.astro";
import { SAJT } from "../consts";
import { intern } from "../lankar";

interface Props {
  titel?: string;
  beskrivning?: string;
  visaSidfot?: boolean;
}

const {
  titel,
  beskrivning = SAJT.beskrivning,
  visaSidfot = true,
} = Astro.props;

const helTitel = titel ? `${titel} — ${SAJT.titel}` : SAJT.titel;
const kanonisk = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{helTitel}</title>
    <meta name="description" content={beskrivning} />
    <link rel="canonical" href={kanonisk} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={helTitel} />
    <meta property="og:description" content={beskrivning} />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:url" content={kanonisk} />
    <meta name="theme-color" content="#f3efe7" />
    <link rel="icon" href={intern("/favicon.svg")} type="image/svg+xml" />
  </head>
  <body>
    <a class="hoppa" href="#innehall">Hoppa till innehållet</a>
    <Topbar />
    <main id="innehall">
      <slot />
    </main>
    {visaSidfot && <Sidfot />}
  </body>
</html>
